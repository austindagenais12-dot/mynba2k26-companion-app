; Engine configuration file.
; Full Court Legacy — original player-lock basketball prototype.

config_version=5

[application]

config/name="Full Court Legacy"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.012, 0.035, 0.08, 1)
boot_splash/image="res://icon.svg"
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.018, 0.045, 1)
textures/default_filters/use_nearest_mipmap_filter=false

